#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define SIZE 10
int main()
{
    int a[SIZE], sum=0, t;
    srand(time(NULL));
    for(int i=0;i<SIZE;i++) a[i]=rand()%101;
    for(int i=0;i<SIZE-1;i++)
        for(int j=0;j<SIZE-1-i;j++)
            if(a[j]>a[j+1]){ t=a[j]; a[j]=a[j+1]; a[j+1]=t; }
    for(int i=0;i<SIZE;i++){ printf("%3d ",a[i]); sum+=a[i]; }
    printf("\n최댓값: %d\n최솟값: %d\n평균: %.2f\n",a[SIZE-1],a[0],(double)sum/SIZE);
    return 0;
}
